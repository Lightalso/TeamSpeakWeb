# Host address and TCP port published by compose.yaml.
# Use 127.0.0.1 when an HTTPS reverse proxy runs on the same host.
TSWEB_BIND=0.0.0.0
TSWEB_PORT=3000

# Lock every browser session to one TeamSpeak server. The address is resolved
# by the gateway and is never taken from a browser request while locked.
TSWEB_LOCK_SERVER=false

# compose.yaml maps this hostname to the Docker host on Linux and Docker Desktop.
# If TeamSpeak is another container on the same network, use its service name.
TSWEB_TEAMSPEAK_ADDRESS=host.docker.internal:9987
